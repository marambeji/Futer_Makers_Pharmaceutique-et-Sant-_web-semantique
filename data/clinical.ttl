ph:Consultation4 a ph:Consultation, owl:NamedIndividual ; rdfs:label "Consultation Inès / Sami"@fr ; ph:concernePatient ph:Ines ; ph:realiseePar ph:Sami ; ph:diagnostique ph:Asthme ; ph:dateConsultation "2026-07-05"^^xsd:date ; ph:cout "50"^^xsd:decimal .
ph:Consultation5 a ph:Consultation, owl:NamedIndividual ; rdfs:label "Consultation Omar / Leïla"@fr ; ph:concernePatient ph:Omar ; ph:realiseePar ph:Leila ; ph:diagnostique ph:Hypertension ; ph:proposeTraitement ph:TraitementB ; ph:dateConsultation "2026-03-15"^^xsd:date ; ph:cout "85"^^xsd:decimal .
ph:Consultation6 a ph:Consultation, owl:NamedIndividual ; rdfs:label "Consultation Aziz / Ahmed"@fr ; ph:concernePatient ph:Aziz ; ph:realiseePar ph:Ahmed ; ph:diagnostique ph:Diabete ; ph:dateConsultation "2026-10-20"^^xsd:date ; ph:cout "70"^^xsd:decimal .
ph:Consultation7 a ph:Consultation, owl:NamedIndividual ; rdfs:label "Consultation Meriem / Leïla"@fr ; ph:concernePatient ph:Meriem ; ph:realiseePar ph:Leila ; ph:diagnostique ph:Hypertension ; ph:dateConsultation "2026-06-10"^^xsd:date ; ph:cout "85"^^xsd:decimal .
ph:Consultation8 a ph:Consultation, owl:NamedIndividual ; rdfs:label "Consultation Salma / Sami"@fr ; ph:concernePatient ph:Salma ; ph:realiseePar ph:Sami ; ph:diagnostique ph:Asthme ; ph:dateConsultation "2025-12-03"^^xsd:date ; ph:cout "50"^^xsd:decimal .
ph:Prescription1 a ph:Prescription, owl:NamedIndividual ; rdfs:label "Prescription Nour octobre"@fr ; ph:prescritA ph:Nour ; ph:prescritPar ph:Ahmed ; ph:prescritMedicament ph:MedAlpha, ph:MedBeta ; ph:issueConsultation ph:Consultation1 ; ph:datePrescription "2026-10-01"^^xsd:date ; ph:dureeJours 30 .
ph:Prescription2 a ph:Prescription, owl:NamedIndividual ; rdfs:label "Prescription Youssef août"@fr ; ph:prescritA ph:Youssef ; ph:prescritPar ph:Ahmed ; ph:prescritMedicament ph:MedAlpha ; ph:issueConsultation ph:Consultation3 ; ph:datePrescription "2026-08-20"^^xsd:date ; ph:dureeJours 60 .
ph:Prescription3 a ph:Prescription, owl:NamedIndividual ; rdfs:label "Prescription Inès juillet"@fr ; ph:prescritA ph:Ines ; ph:prescritPar ph:Sami ; ph:prescritMedicament ph:MedGamma ; ph:issueConsultation ph:Consultation4 ; ph:datePrescription "2026-07-05"^^xsd:date ; ph:dureeJours 15 .
ph:Prescription4 a ph:Prescription, owl:NamedIndividual ; rdfs:label "Prescription Omar mars"@fr ; ph:prescritA ph:Omar ; ph:prescritPar ph:Leila ; ph:prescritMedicament ph:MedBeta ; ph:issueConsultation ph:Consultation5 ; ph:datePrescription "2026-03-15"^^xsd:date ; ph:dureeJours 30 .
ph:Prescription5 a ph:Prescription, owl:NamedIndividual ; rdfs:label "Prescription Salma décembre"@fr ; ph:prescritA ph:Salma ; ph:prescritPar ph:Sami ; ph:prescritMedicament ph:MedGamma ; ph:issueConsultation ph:Consultation8 ; ph:datePrescription "2025-12-03"^^xsd:date ; ph:dureeJours 10 .
ph:Rdv1 a ph:RendezVous, owl:NamedIndividual ; rdfs:label "Rendez-vous Nour"@fr ; ph:rdvPatient ph:Nour ; ph:rdvMedecin ph:Ahmed ; ph:dateRdv "2026-10-28"^^xsd:date ; ph:statutRdv "Planifié" .
ph:Rdv2 a ph:RendezVous, owl:NamedIndividual ; rdfs:label "Rendez-vous Adam"@fr ; ph:rdvPatient ph:Adam ; ph:rdvMedecin ph:Sami ; ph:dateRdv "2026-10-27"^^xsd:date ; ph:statutRdv "Planifié" .
